{
  "name": "create-koa-agent",
  "version": "7.2.0",
  "description": "Scaffold Angular projects that are native to AI agents — agentic harness, real-time guardrails, and living indexes out of the box.",
  "main": "index.js",
  "bin": {
    "create-koa-agent": "./bin/index.js"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:cli && npm run test:hooks && npm run test:guardrails && npm run test:provocacion",
    "test:cli": "node --test test/*.test.mjs",
    "test:hooks": "node --test templates/.claude/tests/*.test.js",
    "test:guardrails": "cd templates/boilerplate && node --test scripts/lib/*.test.mjs",
    "test:provocacion": "cd templates/boilerplate && node scripts/provocar-reglas.mjs",
    "test:integracion": "node --test test/integracion/*.test.mjs"
  },
  "keywords": [
    "angular",
    "scaffold",
    "claude-code",
    "ai-agents",
    "supabase",
    "cli",
    "create-app"
  ],
  "author": "Akxlarre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akxlarre/Koa-agent-cli.git"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "inquirer": "^13.3.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
