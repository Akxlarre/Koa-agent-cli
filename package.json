{
  "name": "koa-agent-cli",
  "version": "1.0.0",
  "description": "Scaffold Angular projects that are native to AI agents — agentic harness, real-time guardrails, and living indexes out of the box.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:cli && npm run test:hooks",
    "test:cli": "node --test test/*.test.mjs",
    "test:hooks": "node --test templates/.claude/tests/*.test.js"
  },
  "keywords": [
    "angular",
    "scaffold",
    "claude-code",
    "ai-agents",
    "supabase",
    "cli",
    "create-app"
  ],
  "author": "Akxlarre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akxlarre/Koa-agent-cli.git"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "inquirer": "^13.3.0",
    "ora": "^9.3.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-koa-agent": "./bin/index.js"
  }
}
